<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="24dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVolverNuevoUsuario"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:src="@drawable/ic_flecha_regreso_usuarios"
                android:contentDescription="Volver"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nuevo usuario"
                android:textColor="#172B5B"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DESCRIPCIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Completa la información para registrar una nueva cuenta en TechMarket."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- TIPO DE DOCUMENTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_documento"
                android:tint="#A5AAB1"
                android:contentDescription="Tipo de documento" />

            <Spinner
                android:id="@+id/spTipoDocumentoNuevo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:gravity="center_vertical" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_flecha_abajo"
                android:tint="#A5AAB1"
                android:contentDescription="Desplegar" />

        </LinearLayout>

        <!-- NÚMERO DE DOCUMENTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_identificacion"
                android:tint="#A5AAB1"
                android:contentDescription="Número de documento" />

            <EditText
                android:id="@+id/etDocumentoNuevo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Número de documento"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- NOMBRES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Nombres" />

            <EditText
                android:id="@+id/etNombresNuevo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Nombres"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- APELLIDOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Apellidos" />

            <EditText
                android:id="@+id/etApellidosNuevo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Apellidos"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CORREO ELECTRÓNICO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_correo"
                android:tint="#A5AAB1"
                android:contentDescription="Correo electrónico" />

            <EditText
                android:id="@+id/etCorreoNuevo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- SEPARADOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#E5E5E5" />

        <!-- TÍTULO INFORMACIÓN DE CUENTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Información de la cuenta"
            android:textColor="#172B5B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- ROL DEL USUARIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Rol del usuario" />

            <Spinner
                android:id="@+id/spRolNuevo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:gravity="center_vertical" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_flecha_abajo"
                android:tint="#A5AAB1"
                android:contentDescription="Desplegar" />

        </LinearLayout>

        <!-- CONTRASEÑA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_candado"
                android:tint="#A5AAB1"
                android:contentDescription="Contraseña" />

            <EditText
                android:id="@+id/etContrasenaNuevo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Contraseña inicial"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- AYUDA CONTRASEÑA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="22dp"
            android:text="La contraseña debe contener al menos 8 caracteres."
            android:textColor="#858585"
            android:textSize="12sp" />

        <!-- CREAR USUARIO -->
        <Button
            android:id="@+id/btnGuardarNuevoUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#0A54D5"
            android:text="CREAR USUARIO"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- CANCELAR -->
        <Button
            android:id="@+id/btnCancelarNuevoUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E9EDF5"
            android:text="CANCELAR"
            android:textColor="#172B5B"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
