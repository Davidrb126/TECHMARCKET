<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="35dp">

        <ImageButton
            android:id="@+id/btnVolverHistorial"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:src="@drawable/ic_flecha_volver"
            app:tint="#64748B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mis compras"
            android:textColor="#202124"
            android:textSize="23sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCarritoHistorial"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Abrir carrito"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_carrito"
            app:tint="#64748B" />

    </LinearLayout>

    <!-- FILTROS -->
    <LinearLayout
        android:id="@+id/contenedorFiltrosPedidos"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <Button
            android:id="@+id/btnFiltroTodas"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="#E5ECFF"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Todas"
            android:textAllCaps="false"
            android:textColor="#1646C8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFiltroEnProceso"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F1F1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="En proceso"
            android:textAllCaps="false"
            android:textColor="#172554"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFiltroEntregadas"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F1F1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Entregadas"
            android:textAllCaps="false"
            android:textColor="#172554"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- LISTA DE PEDIDOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorialCompras"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="9dp"
        android:paddingTop="25dp"
        android:paddingEnd="9dp"
        android:paddingBottom="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:id="@+id/navInferiorHistorial"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/navInicioHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Inicio"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_inicio"
                app:tint="#777777" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PRODUCTOS -->
        <LinearLayout
            android:id="@+id/navProductosHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Productos"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_productos"
                app:tint="#1646C8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos"
                android:textColor="#1646C8"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FAVORITOS -->
        <LinearLayout
            android:id="@+id/navFavoritosHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Favoritos"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_favoritos"
                app:tint="#777777" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoritos"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/navPerfilHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Perfil"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_perfil_avatar"
                app:tint="#777777" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
