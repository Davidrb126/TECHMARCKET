<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverAgregarProducto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_back"
                android:scaleType="centerInside"
                android:contentDescription="Volver"
                android:tint="#172B65"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Agregar producto"
                android:textColor="#222222"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginEnd="42dp"/>
        </LinearLayout>

        <!-- IMÁGENES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:orientation="horizontal"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/contenedorImagenPrincipalProducto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_area_imagen_producto"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgPrincipalProducto"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/bg_icono_imagen_producto"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:tint="#1769FF"
                    android:contentDescription="Imagen principal"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Imagen principal"
                    android:textColor="#344054"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNG o JPG (máx. 5 MB)"
                    android:textColor="#667085"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="62dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="20dp">

                <ImageButton
                    android:id="@+id/btnImagenProducto2"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_boton_imagen_producto"
                    android:src="@android:drawable/ic_input_add"
                    android:padding="18dp"
                    android:tint="#6095FF"
                    android:contentDescription="Segunda imagen"/>

                <ImageButton
                    android:id="@+id/btnImagenProducto3"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_boton_imagen_producto"
                    android:src="@android:drawable/ic_input_add"
                    android:padding="18dp"
                    android:tint="#6095FF"
                    android:contentDescription="Tercera imagen"/>

                <ImageButton
                    android:id="@+id/btnImagenProducto4"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_boton_imagen_producto"
                    android:src="@android:drawable/ic_input_add"
                    android:padding="18dp"
                    android:tint="#6095FF"
                    android:contentDescription="Cuarta imagen"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DISPONIBILIDAD -->
        <Switch
            android:id="@+id/switchProductoDisponible"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:checked="true"
            android:showText="false"
            android:thumbTint="#FFFFFF"
            android:trackTint="#3674F5"
            android:layout_marginBottom="8dp"/>

        <!-- NOMBRE -->
        <EditText
            android:id="@+id/etNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_campo_producto"
            android:hint="Nombre del producto"
            android:paddingStart="26dp"
            android:paddingEnd="16dp"
            android:textColor="#222222"
            android:textColorHint="#292929"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:layout_marginBottom="6dp"/>

        <!-- CATEGORÍA -->
        <Spinner
            android:id="@+id/spCategoriaProducto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_campo_producto"
            android:paddingStart="22dp"
            android:paddingEnd="16dp"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp"/>

        <!-- PRECIO Y STOCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>

                <EditText
                    android:id="@+id/etPrecioProducto"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_campo_producto"
                    android:hint="$ 0"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    android:textColor="#222222"
                    android:textColorHint="#666666"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:inputType="numberDecimal"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock"
                    android:textColor="#222222"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>

                <EditText
                    android:id="@+id/etStockProducto"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_campo_producto"
                    android:hint="0"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    android:textColor="#222222"
                    android:textColorHint="#666666"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:inputType="number"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DESCRIPCIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#222222"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etDescripcionProducto"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_campo_producto"
            android:gravity="top|start"
            android:hint=" "
            android:padding="12dp"
            android:textColor="#222222"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine"
            android:layout_marginBottom="8dp"/>

        <!-- GUARDAR -->
        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#3674F5"
            android:text="Guardar producto"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
