<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverFinalizar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Volver"
                android:padding="8dp"
                android:src="@drawable/ic_flecha_volver"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Finalizar compra"
                android:textColor="#172554"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DIRECCIÓN DE ENTREGA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Dirección de entrega"
            android:textColor="#172554"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#EAF1FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="23sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDireccionFinalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dirección de entrega"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCiudadFinalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Ciudad y departamento"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCambiarDireccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar"
                android:textColor="#1646C8"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MÉTODO DE ENVÍO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Método de envío"
            android:textColor="#172554"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="8dp"
            android:background="#EAF1FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:text="🚚"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Envío estándar"
                    android:textColor="#475569"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 a 5 días hábiles"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCostoEnvio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 10.000"
                android:textColor="#1646C8"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MÉTODO DE PAGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Método de pago"
            android:textColor="#172554"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="8dp"
            android:background="#EAF1FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:text="💳"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/tvMetodoPagoFinalizar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Método de pago seleccionado"
                android:textColor="#475569"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- RESUMEN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Resumen"
            android:textColor="#172554"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Productos"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtotalFinalizar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 0"
                android:textColor="#475569"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Envío"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEnvioFinalizar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 10.000"
                android:textColor="#475569"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TOTAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                android:textColor="#1646C8"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalFinalizar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 10.000"
                android:textColor="#1646C8"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CONFIRMAR COMPRA -->
        <Button
            android:id="@+id/btnConfirmarCompra"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_boton_agregar"
            android:text="Confirmar compra"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
