<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="35dp"
            android:paddingBottom="30dp">

            <!-- LOGO TECHMARKET -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tech"
                    android:textColor="#202020"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Markert"
                    android:textColor="#263DAD"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TÍTULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Crear cuenta de vendedor"
                android:textColor="#777777"
                android:textSize="20sp" />

            <!-- INDICADOR DE LOS TRES PASOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:orientation="horizontal">

                <!-- PASO 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_paso_activo"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Datos básicos"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PASO 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_paso_inactivo"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#111111"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Información de tienda"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PASO 3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_paso_inactivo"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#111111"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Confirmación"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- FORMULARIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="vertical">

                <!-- TIPO DE DOCUMENTO -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <Spinner
                        android:id="@+id/spTipoDocumentoVendedor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_campo_vendedor"
                        android:paddingStart="48dp"
                        android:paddingEnd="18dp" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="17dp"
                        android:contentDescription="Tipo de documento"
                        android:src="@drawable/ic_documento_vendedor" />
                </FrameLayout>

                <!-- NÚMERO DE DOCUMENTO -->
                <EditText
                    android:id="@+id/etDocumentoVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_vendedor"
                    android:drawableStart="@drawable/ic_documento_vendedor"
                    android:drawablePadding="13dp"
                    android:hint="Número de documento"
                    android:inputType="number"
                    android:paddingStart="17dp"
                    android:paddingEnd="15dp"
                    android:textSize="16sp" />

                <!-- NOMBRE COMPLETO -->
                <EditText
                    android:id="@+id/etNombreCompletoVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_vendedor"
                    android:drawableStart="@drawable/ic_usuario_vendedor"
                    android:drawablePadding="13dp"
                    android:hint="Nombre completo"
                    android:inputType="textCapWords"
                    android:paddingStart="17dp"
                    android:paddingEnd="15dp"
                    android:textSize="16sp" />

                <!-- CORREO ELECTRÓNICO -->
                <EditText
                    android:id="@+id/etCorreoVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_vendedor"
                    android:drawableStart="@drawable/ic_correo_vendedor"
                    android:drawablePadding="13dp"
                    android:hint="Correo electrónico"
                    android:inputType="textEmailAddress"
                    android:paddingStart="17dp"
                    android:paddingEnd="15dp"
                    android:textSize="16sp" />

                <!-- TELÉFONO -->
                <EditText
                    android:id="@+id/etTelefonoVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_vendedor"
                    android:drawableStart="@drawable/ic_telefono_vendedor"
                    android:drawablePadding="13dp"
                    android:hint="Teléfono"
                    android:inputType="phone"
                    android:paddingStart="17dp"
                    android:paddingEnd="15dp"
                    android:textSize="16sp" />

                <!-- CONTRASEÑA -->
                <EditText
                    android:id="@+id/etContrasenaVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_vendedor"
                    android:drawableStart="@drawable/ic_bloqueo_vendedor"
                    android:drawablePadding="13dp"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="17dp"
                    android:paddingEnd="15dp"
                    android:textSize="16sp" />

                <!-- CONFIRMAR CONTRASEÑA -->
                <EditText
                    android:id="@+id/etConfirmarContrasenaVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo_vendedor"
                    android:drawableStart="@drawable/ic_bloqueo_vendedor"
                    android:drawablePadding="13dp"
                    android:hint="Confirmar contraseña"
                    android:inputType="textPassword"
                    android:paddingStart="17dp"
                    android:paddingEnd="15dp"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- BOTÓN SIGUIENTE -->
            <Button
                android:id="@+id/btnSiguienteVendedor"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#0A54D5"
                android:text="Siguiente"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ACCESO AL LOGIN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes cuenta? "
                    android:textColor="#888888"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvIniciarSesionVendedor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicia sesión"
                    android:textColor="#3678DF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- FLECHA INDEPENDIENTE DEL CONTENIDO -->
    <ImageButton
        android:id="@+id/btnVolverRegistroVendedor"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="15dp"
        android:layout_marginTop="45dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Volver al inicio de sesión"
        android:scaleType="centerInside"
        android:padding="8dp" />

</FrameLayout>
