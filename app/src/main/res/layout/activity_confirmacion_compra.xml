<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnVolverConfirmacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:src="@drawable/ic_flecha_volver"
            android:tint="#64748B" />

        <TextView
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_marginTop="35dp"
            android:background="@drawable/bg_exito_confirmacion"
            android:gravity="center"
            android:text="✓"
            android:textColor="#079455"
            android:textSize="68sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="¡Compra realizada\ncon éxito!"
            android:textColor="#202124"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNumeroPedidoConfirmacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Tu pedido #TM12345 ha sido registrado."
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Te enviaremos un correo con los detalles de tu compra."
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="55dp" />

        <Button
            android:id="@+id/btnVerMisCompras"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_boton_agregar"
            android:text="Ver mis compras"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSeguirComprando"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#DCE6FF"
            android:text="Seguir comprando"
            android:textAllCaps="false"
            android:textColor="#1646C8"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
