<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/btnVolverDetalle"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="15dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_flecha_volver"
                    app:tint="#172554"
                    android:scaleType="centerInside"
                    android:padding="3dp"
                    android:contentDescription="Volver" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:text="Detalle del producto"
                    android:textColor="#172554"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageButton
                    android:id="@+id/btnCarritoDetalle"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="15dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_carrito"
                    app:tint="#1646C8"
                    android:scaleType="fitCenter"
                    android:padding="11dp"
                    android:contentDescription="Ver carrito" />

            </LinearLayout>

            <!-- IMAGEN DEL PRODUCTO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_detalle_imagen">

                <ImageView
                    android:id="@+id/imgDetalleProducto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:contentDescription="Imagen del producto" />

            </FrameLayout>

            <!-- INFORMACIÓN DEL PRODUCTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="TECNOLOGÍA Y ACCESORIOS"
                    android:textColor="#1646C8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvNombreDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Audífonos Bluetooth SoundPro"
                    android:textColor="#172554"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvCalificacionDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="⭐  4.8     |     125 opiniones"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPrecioDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="$ 120.000"
                    android:textColor="#1646C8"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="#16A36A" />

                    <TextView
                        android:id="@+id/tvDisponibilidadDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Disponible"
                        android:textColor="#16834A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="22dp"
                    android:background="#EAEFF5" />

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción del producto"
                    android:textColor="#172554"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDescripcionDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Disfruta de tu música favorita con estos audífonos Bluetooth. Diseño moderno, conexión inalámbrica y excelente calidad de sonido para acompañarte en cualquier momento."
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />

                <!-- SELECTOR DE CANTIDAD -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Selecciona la cantidad"
                    android:textColor="#172554"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="160dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_selector_cantidad">

                    <ImageButton
                        android:id="@+id/btnDisminuirCantidad"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_boton_cantidad"
                        android:src="@drawable/ic_menos"
                        app:tint="#1646C8"
                        android:padding="10dp"
                        android:contentDescription="Disminuir cantidad" />

                    <TextView
                        android:id="@+id/tvCantidad"
                        android:layout_width="65dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#172554"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnAumentarCantidad"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_boton_cantidad"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="#1646C8"
                        android:padding="10dp"
                        android:contentDescription="Aumentar cantidad" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTÓN FIJO EN LA PARTE INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF"
        android:elevation="12dp">

        <Button
            android:id="@+id/btnAgregarAlCarrito"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_boton_agregar"
            android:text="AGREGAR AL CARRITO"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

    </LinearLayout>

</LinearLayout>
