<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="16dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVolverEditarTienda"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:src="@drawable/ic_flecha_regreso_usuarios"
                android:contentDescription="Volver"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Editar tienda"
                android:textColor="#172B5B"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"
            android:text="Actualiza la información de la tienda registrada."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- INFORMACIÓN DEL VENDEDOR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VENDEDOR ASOCIADO"
            android:textColor="#172B5B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_input">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del vendedor"
                android:textColor="#858585"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVendedorEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vendedor"
                android:textColor="#172B5B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Número de documento"
                android:textColor="#858585"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDocumentoEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Documento"
                android:textColor="#172B5B"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- INFORMACIÓN DE LA TIENDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="INFORMACIÓN DE LA TIENDA"
            android:textColor="#172B5B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- NOMBRE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Nombre de tienda" />

            <EditText
                android:id="@+id/etNombreTiendaEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Nombre de la tienda"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- DESCRIPCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="18dp"
                android:src="@drawable/ic_documento"
                android:tint="#A5AAB1"
                android:contentDescription="Descripción" />

            <EditText
                android:id="@+id/etDescripcionEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:paddingTop="18dp"
                android:hint="Descripción de la tienda"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- DIRECCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_documento"
                android:tint="#A5AAB1"
                android:contentDescription="Dirección" />

            <EditText
                android:id="@+id/etDireccionEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Dirección (opcional)"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- SITIO WEB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_correo"
                android:tint="#A5AAB1"
                android:contentDescription="Sitio web o redes" />

            <EditText
                android:id="@+id/etSitioWebEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Sitio web o redes sociales (opcional)"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- BOTÓN GUARDAR -->
        <Button
            android:id="@+id/btnGuardarCambiosTienda"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_boton_guardar_tienda"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="GUARDAR CAMBIOS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <!-- BOTÓN CANCELAR -->
        <Button
            android:id="@+id/btnCancelarEditarTienda"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_boton_cancelar_tienda"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="CANCELAR"
            android:textColor="#1646C8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

    </LinearLayout>

</ScrollView>
