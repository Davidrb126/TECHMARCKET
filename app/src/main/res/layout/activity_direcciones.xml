<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnVolverDirecciones"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#202124"
            android:textSize="34sp"
            android:contentDescription="Volver"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Mis direcciones"
            android:textColor="#172B5B"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- INFORMACIÓN -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Información de entrega"
        android:textColor="#172B5B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Administra las direcciones donde deseas recibir tus compras."
        android:textColor="#777777"
        android:textSize="14sp" />

    <!-- AGREGAR DIRECCIÓN -->

    <Button
        android:id="@+id/btnAgregarDireccion"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_boton_direccion"
        android:text="+ Agregar dirección"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="0dp" />

    <!-- TÍTULO DEL LISTADO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="12dp"
        android:text="Mis direcciones guardadas"
        android:textColor="#172B5B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- LISTADO -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/contenedorDirecciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
