<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PRUEBA DE FIREBASE"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#172554"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TechMarket - Conexión con Cloud Firestore"
        android:textSize="15sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnGuardarFirebase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GUARDAR EN FIREBASE" />

    <Button
        android:id="@+id/btnLeerFirebase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LEER DESDE FIREBASE"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvResultadoFirebase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Esperando prueba de conexión..."
        android:textSize="16sp"
        android:textColor="#222222"
        android:gravity="center"
        android:padding="20dp"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF" />

</LinearLayout>
