<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolverMisDatos"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:contentDescription="Volver"
                android:padding="10dp"
                android:src="@drawable/ic_flecha_volver"
                android:tint="#64748B" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mis datos"
                android:textColor="#202124"
                android:textSize="23sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="45dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Información personal"
            android:textColor="#172554"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Consulta y actualiza la información de tu cuenta."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- TIPO DOCUMENTO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tipo de documento"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTipoDocumentoMisDatos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#777777"
            android:textSize="15sp" />

        <!-- DOCUMENTO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Número de documento"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDocumentoMisDatos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#777777"
            android:textSize="15sp" />

        <!-- NOMBRES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Nombres"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombresMisDatos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#202124"
            android:textSize="15sp" />

        <!-- APELLIDOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Apellidos"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApellidosMisDatos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#202124"
            android:textSize="15sp" />

        <!-- CORREO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Correo electrónico"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreoMisDatos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#202124"
            android:textSize="15sp" />

        <!-- BOTÓN GUARDAR -->
        <Button
            android:id="@+id/btnGuardarMisDatos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#0755FF"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelarMisDatos"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#EEF2FF"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#0755FF"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
