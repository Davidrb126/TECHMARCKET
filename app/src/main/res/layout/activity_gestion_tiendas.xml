<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVolverTiendas"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_flecha_regreso_usuarios"
                    android:contentDescription="Volver"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Gestión de tiendas"
                    android:textColor="#172B5B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- DESCRIPCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Administra las tiendas registradas en TechMarket."
                android:textColor="#737B8C"
                android:textSize="14sp" />

            <!-- TOTAL DE TIENDAS -->
            <TextView
                android:id="@+id/tvTotalTiendas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Tiendas registradas: 0"
                android:textColor="#172B5B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- BUSCADOR -->
            <EditText
                android:id="@+id/etBuscarTienda"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_busqueda_usuario"
                android:hint="Buscar por tienda o vendedor"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#263248"
                android:textColorHint="#9299A6"
                android:textSize="14sp" />

            <!-- BOTÓN NUEVA TIENDA -->
            <Button
                android:id="@+id/btnNuevaTiendaAdmin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="18dp"
                android:backgroundTint="#0A54D5"
                android:text="+ NUEVA TIENDA"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- LISTADO DINÁMICO -->
            <LinearLayout
                android:id="@+id/contenedorTiendas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/navInicioAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNavInicioAdmin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_inicio"
                android:contentDescription="Inicio" />

            <TextView
                android:id="@+id/tvNavInicioAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inicio"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- USUARIOS -->
        <LinearLayout
            android:id="@+id/navUsuariosAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNavUsuariosAdmin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_usuario"
                android:contentDescription="Usuarios" />

            <TextView
                android:id="@+id/tvNavUsuariosAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Usuarios"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- TIENDAS -->
        <LinearLayout
            android:id="@+id/navTiendasAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNavTiendasAdmin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tienda_vendedor"
                android:contentDescription="Tiendas" />

            <TextView
                android:id="@+id/tvNavTiendasAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tiendas"
                android:textColor="#0755FF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CATEGORÍAS -->
        <LinearLayout
            android:id="@+id/navCategoriasAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgNavCategoriasAdmin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_categorias"
                android:contentDescription="Categorías" />

            <TextView
                android:id="@+id/tvNavCategoriasAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Categorías"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
