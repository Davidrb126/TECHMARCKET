<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/btnVolverPerfil"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="10dp"
            android:src="@drawable/ic_flecha_volver"
            android:tint="#64748B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mi perfil"
            android:textColor="#202124"
            android:textSize="23sp"
            android:textStyle="bold" />

        <View
            android:layout_width="45dp"
            android:layout_height="45dp" />

    </LinearLayout>

    <!-- INFORMACIÓN DEL COMPRADOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/imgAvatarPerfil"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_avatar_perfil"
            android:contentDescription="Foto de perfil"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_perfil_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="David Alberto Rodriguez"
                android:textColor="#172554"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="david@gmail.com"
                android:textColor="#999999"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEditarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Editar perfil"
                android:textColor="#304FFE"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- OPCIONES DEL PERFIL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <!-- MIS DATOS -->
        <LinearLayout
            android:id="@+id/opcionMisDatos"
            style="@style/OpcionPerfil"
            android:contentDescription="Mis datos">

            <ImageView
                style="@style/ImagenOpcionPerfil"
                android:contentDescription="Mis datos"
                android:src="@drawable/ic_perfil_datos" />

            <TextView
                style="@style/TextOpcionPerfil"
                android:text="Mis Datos"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FlechaOpcionPerfil"
                android:text="›" />

        </LinearLayout>

        <!-- DIRECCIONES -->
        <LinearLayout
            android:id="@+id/opcionDirecciones"
            style="@style/OpcionPerfil"
            android:contentDescription="Direcciones">

            <ImageView
                style="@style/ImagenOpcionPerfil"
                android:contentDescription="Direcciones"
                android:src="@drawable/ic_perfil_direccion" />

            <TextView
                style="@style/TextOpcionPerfil"
                android:text="Direcciones"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FlechaOpcionPerfil"
                android:text="›" />

        </LinearLayout>

        <!-- MIS COMPRAS -->
        <LinearLayout
            android:id="@+id/opcionMisCompras"
            style="@style/OpcionPerfil">

            <ImageView
                style="@style/ImagenOpcionPerfil"
                android:contentDescription="Mis compras"
                android:src="@drawable/ic_perfil_compras" />

            <TextView
                style="@style/TextOpcionPerfil"
                android:text="Mis compras"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FlechaOpcionPerfil"
                android:text="›" />

        </LinearLayout>

        <!-- MÉTODOS DE PAGO -->
        <LinearLayout
            android:id="@+id/opcionMetodosPago"
            style="@style/OpcionPerfil">

            <ImageView
                style="@style/ImagenOpcionPerfil"
                android:contentDescription="Métodos de pago"
                android:src="@drawable/ic_perfil_pago" />

            <TextView
                style="@style/TextOpcionPerfil"
                android:text="Métodos de pago"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FlechaOpcionPerfil"
                android:text="›" />

        </LinearLayout>

        <!-- NOTIFICACIONES -->
        <LinearLayout
            android:id="@+id/opcionNotificaciones"
            style="@style/OpcionPerfil">

            <ImageView
                style="@style/ImagenOpcionPerfil"
                android:contentDescription="Notificaciones"
                android:src="@drawable/ic_perfil_notificaciones" />

            <TextView
                style="@style/TextOpcionPerfil"
                android:text="Notificaciones"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FlechaOpcionPerfil"
                android:text="›" />

        </LinearLayout>

        <!-- CAMBIAR CONTRASEÑA -->
        <LinearLayout
            android:id="@+id/opcionCambiarContrasena"
            style="@style/OpcionPerfil">

            <ImageView
                style="@style/ImagenOpcionPerfil"
                android:contentDescription="Cambiar contraseña"
                android:src="@drawable/ic_perfil_seguridad" />

            <TextView
                style="@style/TextOpcionPerfil"
                android:text="Cambiar contraseña"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FlechaOpcionPerfil"
                android:text="›" />

        </LinearLayout>

    </LinearLayout>

    <!-- CERRAR SESIÓN -->
    <LinearLayout
        android:id="@+id/btnCerrarSesionPerfil"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:contentDescription="Cerrar sesión"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_perfil_logout" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Cerrar sesión"
            android:textColor="#FF4938"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ESPACIO FLEXIBLE -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:id="@+id/navInferiorPerfil"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/navInicioPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavInicioPerfil"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_nav_inicio"
                android:tint="#777777"
                android:tintMode="src_in" />

            <TextView
                android:id="@+id/tvNavInicioPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PRODUCTOS -->
        <LinearLayout
            android:id="@+id/navProductosPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgNavProductosPerfil"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Productos"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_productos"
                app:tint="#777777" />

            <TextView
                android:id="@+id/tvNavProductosPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- FAVORITOS -->
        <LinearLayout
            android:id="@+id/navFavoritosPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavFavoritosPerfil"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Favoritos"
                android:src="@drawable/ic_nav_favoritos"
                android:tint="#777777"
                android:tintMode="src_in" />

            <TextView
                android:id="@+id/tvNavFavoritosPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoritos"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PERFIL SELECCIONADO -->
        <LinearLayout
            android:id="@+id/navPerfilActual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavPerfilActual"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Perfil"
                android:src="@drawable/ic_perfil_avatar"
                android:tint="#0755FF"
                android:tintMode="src_in" />

            <TextView
                android:id="@+id/tvNavPerfilActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#0755FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>