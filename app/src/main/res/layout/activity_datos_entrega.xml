<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVolverDirecciones"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="‹"
                android:textColor="#202124"
                android:textSize="36sp"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Datos de entrega"
                android:textColor="#172B5B"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Título y descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="¿Dónde quieres recibir tu pedido?"
            android:textColor="#172B5B"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Completa tus datos para que podamos entregar tu compra correctamente."
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <!-- Direcciones guardadas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Seleccionar dirección guardada"
            android:textColor="#172B5B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDireccionesGuardadas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_selector_cantidad"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Selecciona una dirección o ingresa los datos manualmente."
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <!-- Información personal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="Información personal"
            android:textColor="#172B5B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nombre completo"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreEntrega"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:hint="Ingresa tu nombre completo"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Número de documento"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDocumentoEntrega"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:hint="Número de documento"
            android:inputType="number"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Teléfono"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTelefonoEntrega"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:hint="Número de contacto"
            android:inputType="phone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Correo electrónico"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreoEntrega"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <!-- Dirección de entrega -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Dirección de entrega"
            android:textColor="#172B5B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Departamento"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDepartamentoEntrega"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:hint="Ej. Cundinamarca"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ciudad o municipio"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCiudadEntrega"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:hint="Ej. Bogotá"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Dirección completa"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDireccionEntrega"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:hint="Calle, carrera, número, apartamento..."
            android:inputType="textPostalAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Información adicional (opcional)"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etInformacionAdicional"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_selector_cantidad"
            android:gravity="top"
            android:hint="Indicaciones para encontrar tu dirección"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:textColor="#172B5B"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <!-- Botón continuar -->
        <Button
            android:id="@+id/btnContinuarPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/bg_boton_agregar"
            android:text="Continuar al pago"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
