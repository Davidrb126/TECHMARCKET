<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_selector_cantidad"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imgProductoCarrito"
        android:layout_width="85dp"
        android:layout_height="95dp"
        android:scaleType="centerInside"
        android:background="@drawable/bg_detalle_imagen"
        android:padding="8dp"
        android:contentDescription="Imagen del producto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvNombreProductoCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del producto"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#172554"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvPrecioProductoCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 120.000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1646C8"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnDisminuirCarrito"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_menos"
                android:background="@drawable/bg_boton_cantidad"
                android:scaleType="centerInside"
                android:contentDescription="Disminuir cantidad" />

            <TextView
                android:id="@+id/tvCantidadProductoCarrito"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#172554"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnAumentarCarrito"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:background="@drawable/bg_boton_cantidad"
                android:scaleType="centerInside"
                android:contentDescription="Aumentar cantidad" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEliminarProductoCarrito"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:tint="#DC2626"
        android:contentDescription="Eliminar producto" />

</LinearLayout>
