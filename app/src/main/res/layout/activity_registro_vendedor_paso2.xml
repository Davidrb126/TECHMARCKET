<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="35dp"
        android:paddingBottom="30dp">

        <!-- LOGO TECHMARKET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tech"
                android:textColor="#202020"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Markert"
                android:textColor="#263DAD"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Información de tu tienda"
            android:textColor="#252525"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Cuéntanos sobre tu negocio"
            android:textColor="#777777"
            android:textSize="16sp" />

        <!-- INDICADOR DE LOS TRES PASOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal">

            <!-- PASO 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_paso_inactivo"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#111111"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Datos básicos"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PASO 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_paso_activo"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Información de tienda"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PASO 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_paso_inactivo"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#111111"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Confirmación"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- LOGO DE LA TIENDA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="116dp"
                android:layout_height="116dp">

                <ImageView
                    android:id="@+id/imgLogoTiendaVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo_tienda"
                    android:contentDescription="Logo de la tienda"
                    android:padding="27dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_tienda_vendedor" />

                <ImageView
                    android:id="@+id/btnSeleccionarLogoTienda"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_paso_activo"
                    android:contentDescription="Seleccionar logo"
                    android:padding="9dp"
                    android:src="@drawable/ic_camara_vendedor" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Logo de la tienda"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="PNG o JPG (máx. 2 MB)"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- FORMULARIO DE TIENDA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="vertical">

            <!-- NOMBRE DE LA TIENDA -->
            <EditText
                android:id="@+id/etNombreTiendaVendedor"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_campo_vendedor"
                android:drawableStart="@drawable/ic_tienda_vendedor"
                android:drawablePadding="13dp"
                android:hint="Nombre de la tienda"
                android:inputType="textCapWords"
                android:paddingStart="17dp"
                android:paddingEnd="15dp"
                android:textSize="16sp" />

            <!-- DESCRIPCIÓN -->
            <EditText
                android:id="@+id/etDescripcionTiendaVendedor"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_campo_vendedor"
                android:drawableStart="@drawable/ic_descripcion_vendedor"
                android:drawablePadding="13dp"
                android:gravity="top"
                android:hint="Describe brevemente tu tienda y los productos que vendes"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingStart="17dp"
                android:paddingTop="17dp"
                android:paddingEnd="15dp"
                android:textSize="15sp" />

            <!-- DIRECCIÓN OPCIONAL -->
            <EditText
                android:id="@+id/etDireccionTiendaVendedor"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_campo_vendedor"
                android:drawableStart="@drawable/ic_ubicacion_vendedor"
                android:drawablePadding="13dp"
                android:hint="Dirección (opcional)"
                android:inputType="textCapSentences"
                android:paddingStart="17dp"
                android:paddingEnd="15dp"
                android:textSize="16sp" />

            <!-- SITIO WEB O REDES SOCIALES -->
            <EditText
                android:id="@+id/etSitioWebTiendaVendedor"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_campo_vendedor"
                android:drawableStart="@drawable/ic_web_vendedor"
                android:drawablePadding="13dp"
                android:hint="Sitio web o redes sociales (opcional)"
                android:inputType="textUri"
                android:paddingStart="17dp"
                android:paddingEnd="15dp"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- BOTONES DE NAVEGACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAtrasVendedorPaso2"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#EEEEEE"
                android:text="Atrás"
                android:textAllCaps="false"
                android:textColor="#333333"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btnSiguienteVendedorPaso2"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0A54D5"
                android:text="Siguiente"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
