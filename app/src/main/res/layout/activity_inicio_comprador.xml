<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorInicioComprador"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- CONTENIDO PRINCIPAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ENCABEZADO AZUL -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#073987"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- MENÚ -->
                <TextView
                    android:id="@+id/btnMenuComprador"
                    android:layout_width="58dp"
                    android:layout_height="50dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="35dp"
                    android:contentDescription="Abrir menú"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="☰"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />

                <!-- LOGO TECHMARKET -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tech"
                        android:textColor="#FFFFFF"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Market"
                        android:textColor="#67B8FF"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- CARRITO -->
                <FrameLayout
                    android:id="@+id/btnAbrirCarrito"
                    android:layout_width="58dp"
                    android:layout_height="50dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:contentDescription="Abrir carrito">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Carrito de compras"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_carrito" />

                    <TextView
                        android:id="@+id/tvContadorCarrito"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_contador_carrito"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>

            </FrameLayout>

            <!-- CUERPO BLANCO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:background="@drawable/bg_seccion_blanca"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp">

                <!-- BUSCADOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="⌕"
                        android:textColor="#24447D"
                        android:textSize="27sp" />

                    <EditText
                        android:id="@+id/etBuscarProductos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Buscar productos..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:textColor="#202020"
                        android:textColorHint="#777777"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- BANNER PROMOCIONAL -->
                <FrameLayout
                    android:id="@+id/bannerPromocional"
                    android:layout_width="match_parent"
                    android:layout_height="107dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_banner_promocional"
                    android:clipToOutline="true"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingEnd="115dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="La mejor tecnología&#10;a tu alcance"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnVerOfertas"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_ofertas"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Ver ofertas"
                            android:textColor="#073987"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgBannerAudifonos"
                        android:layout_width="115dp"
                        android:layout_height="95dp"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="Audífonos destacados"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_carrito" />

                </FrameLayout>

                <!-- CATEGORÍAS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:scrollbars="none" />

                <!-- TÍTULO PRODUCTOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Productos destacados"
                        android:textColor="#073987"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnVerTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Ver todos"
                        android:textColor="#0038C7"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- PRODUCTOS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProductos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:scrollbars="none" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:id="@+id/navegacionInferior"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavInicio"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_nav_inicio"
                android:tint="#0755FF" />

            <TextView
                android:id="@+id/tvNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="#0755FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CATEGORÍAS -->
        <LinearLayout
            android:id="@+id/navCategorias"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavCategorias"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Categorías"
                android:src="@drawable/ic_nav_categorias"
                android:tint="#777777" />

            <TextView
                android:id="@+id/tvNavCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorías"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- FAVORITOS -->
        <LinearLayout
            android:id="@+id/navFavoritos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavFavoritos"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Favoritos"
                android:src="@drawable/ic_nav_favoritos"
                android:tint="#777777" />

            <TextView
                android:id="@+id/tvNavFavoritos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoritos"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavPerfil"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Perfil"
                android:src="@drawable/ic_perfil_avatar"
                android:tint="#777777" />

            <TextView
                android:id="@+id/tvNavPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#777777"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>