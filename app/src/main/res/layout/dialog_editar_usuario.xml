<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnCerrarEditarUsuario"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:src="@drawable/ic_flecha_regreso_usuarios"
                android:contentDescription="Cerrar"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Editar usuario"
                android:textColor="#172B5B"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DESCRIPCIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Actualiza la información de la cuenta del usuario en TechMarket."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- DOCUMENTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_identificacion"
                android:tint="#A5AAB1"
                android:contentDescription="Documento" />

            <EditText
                android:id="@+id/etDocumentoEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Número de documento"
                android:enabled="false"
                android:singleLine="true"
                android:textColor="#858585"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- NOMBRES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Nombres" />

            <EditText
                android:id="@+id/etNombresEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Nombres"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- APELLIDOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Apellidos" />

            <EditText
                android:id="@+id/etApellidosEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Apellidos"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CORREO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_correo"
                android:tint="#A5AAB1"
                android:contentDescription="Correo electrónico" />

            <EditText
                android:id="@+id/etCorreoEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- SEPARADOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#E5E5E5" />

        <!-- INFORMACIÓN DE CUENTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Información de la cuenta"
            android:textColor="#172B5B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- ROL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Rol" />

            <Spinner
                android:id="@+id/spRolEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:gravity="center_vertical" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_flecha_abajo"
                android:tint="#A5AAB1"
                android:contentDescription="Desplegar" />

        </LinearLayout>

        <!-- ESTADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Estado de la cuenta"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swEstadoEditar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activo"
                android:textColor="#172B5B"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- CONTRASEÑA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_candado"
                android:tint="#A5AAB1"
                android:contentDescription="Contraseña" />

            <EditText
                android:id="@+id/etContrasenaEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Nueva contraseña (opcional)"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- AYUDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="22dp"
            android:text="Deja este campo vacío para conservar la contraseña actual. Si deseas cambiarla, debe contener al menos 8 caracteres."
            android:textColor="#858585"
            android:textSize="12sp" />

        <!-- GUARDAR -->
        <Button
            android:id="@+id/btnGuardarEdicionUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#0A54D5"
            android:text="GUARDAR CAMBIOS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- CANCELAR -->
        <Button
            android:id="@+id/btnCancelarEdicionUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E9EDF5"
            android:text="CANCELAR"
            android:textColor="#172B5B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ELIMINAR USUARIO -->
        <Button
            android:id="@+id/btnEliminarUsuario"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D32F2F"
            android:text="ELIMINAR USUARIO"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
