<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/btnVolverDetalleCompra"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Volver"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detalle de compra"
                android:textColor="#172033"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Información del pedido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_pedido"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INFORMACIÓN DEL PEDIDO"
                android:textColor="#778198"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNumeroPedidoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pedido #000000"
                android:textColor="#172033"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFechaPedidoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Fecha del pedido"
                android:textColor="#778198"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEstadoPedidoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_estado_pedido_proceso"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="En proceso"
                android:textColor="#0A54D5"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Productos -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Productos comprados"
            android:textColor="#172033"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contenedorProductosDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_pedido"
            android:orientation="vertical"
            android:padding="12dp" />

        <!-- Resumen de pago -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Resumen de pago"
            android:textColor="#172033"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_pedido"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSubtotalDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Subtotal: $0"
                android:textColor="#566176"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEnvioDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Envío: $0"
                android:textColor="#566176"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#E6EAF1" />

            <TextView
                android:id="@+id/tvTotalDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total: $0"
                android:textColor="#172033"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- NUEVA SECCIÓN: ESTADO DEL PAGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Estado del pago"
            android:textColor="#172033"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contenedorEstadoPagoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_pedido"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvEstadoPagoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="Pago aprobado"
                android:textColor="#16A34A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescripcionEstadoPagoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Estado de la transacción."
                android:textColor="#566176"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#E6EAF1" />

            <TextView
                android:id="@+id/tvEtiquetaValorPagoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valor pagado"
                android:textColor="#778198"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValorPagoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="$0"
                android:textColor="#172033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProveedorPagoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mercado Pago"
                android:textColor="#778198"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Entrega y pago -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Entrega y pago"
            android:textColor="#172033"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_pedido"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dirección de entrega"
                android:textColor="#778198"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDireccionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Dirección"
                android:textColor="#172033"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Método de pago"
                android:textColor="#778198"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMetodoPagoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Método de pago"
                android:textColor="#172033"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Seguimiento por tienda -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Seguimiento de tiendas"
            android:textColor="#172033"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contenedorTiendasDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
