<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnVolverMetodosPago"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:gravity="center"
                android:text="‹"
                android:textColor="#202124"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Métodos de pago"
                android:textColor="#202124"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tus métodos de pago"
            android:textColor="#202124"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Administra las tarjetas que utilizas para realizar tus compras de forma rápida y sencilla."
            android:textColor="#737373"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Botón agregar -->
        <Button
            android:id="@+id/btnAgregarMetodoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_boton_agregar"
            android:backgroundTint="@null"
            android:elevation="2dp"
            android:text="+  Agregar método de pago"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Encabezado de métodos registrados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Métodos registrados"
                android:textColor="#202124"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Contenedor dinámico de tarjetas -->
        <LinearLayout
            android:id="@+id/contenedorMetodosPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <!-- Estado vacío -->
        <LinearLayout
            android:id="@+id/contenedorVacioMetodos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F8F8F8"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="26dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳"
                android:textSize="42sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Aún no tienes métodos de pago"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Agrega una tarjeta para tenerla disponible en tus próximas compras."
                android:textColor="#737373"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
