<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/btnVolverPerfilVendedor"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Volver"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Mi perfil"
                android:textColor="#172033"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- INTRODUCCIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información personal"
            android:textColor="#172033"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mantén actualizados tus datos personales y de contacto."
            android:textColor="#788397"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <!-- DATOS PERSONALES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos personales"
                android:textColor="#172033"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- TIPO DE DOCUMENTO -->
            <EditText
                android:id="@+id/etTipoDocumentoPerfilVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_documento_vendedor"
                android:drawablePadding="14dp"
                android:hint="Tipo de documento"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172033"
                android:textColorHint="#858B96"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false" />

            <!-- NÚMERO DE DOCUMENTO -->
            <EditText
                android:id="@+id/etDocumentoPerfilVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_identificacion"
                android:drawablePadding="14dp"
                android:hint="Número de documento"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172033"
                android:textColorHint="#858B96"
                android:textSize="16sp"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false" />

            <!-- NOMBRES -->
            <EditText
                android:id="@+id/etNombresPerfilVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_usuario_vendedor"
                android:drawablePadding="14dp"
                android:hint="Nombres"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172033"
                android:textColorHint="#858B96"
                android:textSize="16sp" />

            <!-- APELLIDOS -->
            <EditText
                android:id="@+id/etApellidosPerfilVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_usuario_vendedor"
                android:drawablePadding="14dp"
                android:hint="Apellidos"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172033"
                android:textColorHint="#858B96"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- INFORMACIÓN DE CONTACTO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información de contacto"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp">

            <!-- CORREO -->
            <EditText
                android:id="@+id/etCorreoPerfilVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_correo_vendedor"
                android:drawablePadding="14dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172033"
                android:textColorHint="#858B96"
                android:textSize="16sp" />

            <!-- TELÉFONO -->
            <EditText
                android:id="@+id/etTelefonoPerfilVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_telefono_vendedor"
                android:drawablePadding="14dp"
                android:hint="Número de teléfono"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172033"
                android:textColorHint="#858B96"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- GUARDAR CAMBIOS -->
        <Button
            android:id="@+id/btnGuardarPerfilVendedor"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#0A54D5"
            android:textColor="#FFFFFF" />

        <!-- SEGURIDAD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seguridad"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cambiar contraseña"
                android:textColor="#172033"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- CONTRASEÑA ACTUAL -->
            <EditText
                android:id="@+id/etContrasenaActualVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_bloqueo_vendedor"
                android:drawablePadding="14dp"
                android:hint="Contraseña actual"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="16sp" />

            <!-- NUEVA CONTRASEÑA -->
            <EditText
                android:id="@+id/etNuevaContrasenaVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_bloqueo_vendedor"
                android:drawablePadding="14dp"
                android:hint="Nueva contraseña"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="16sp" />

            <!-- CONFIRMAR CONTRASEÑA -->
            <EditText
                android:id="@+id/etConfirmarContrasenaVendedor"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_campo_perfil"
                android:drawableStart="@drawable/ic_bloqueo_vendedor"
                android:drawablePadding="14dp"
                android:hint="Confirmar nueva contraseña"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="16sp" />

            <!-- ACTUALIZAR CONTRASEÑA -->
            <Button
                android:id="@+id/btnCambiarContrasenaVendedor"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:text="Actualizar contraseña"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#0A54D5"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>
