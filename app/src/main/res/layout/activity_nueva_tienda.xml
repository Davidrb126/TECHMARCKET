<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="24dp">

        <!-- ENCABEZADO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVolverNuevaTienda"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:src="@drawable/ic_flecha_regreso_usuarios"
                android:contentDescription="Volver"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nueva tienda"
                android:textColor="#172B5B"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DESCRIPCIÓN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Completa la información del vendedor y registra su nueva tienda en TechMarket."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- VENDEDOR RESPONSABLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Vendedor responsable"
            android:textColor="#172B5B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Vendedor responsable" />

            <Spinner
                android:id="@+id/spVendedor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:gravity="center_vertical" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_flecha_abajo"
                android:tint="#A5AAB1"
                android:contentDescription="Desplegar" />

        </LinearLayout>

        <!-- SEPARADOR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#E5E5E5" />

        <!-- INFORMACIÓN DE LA TIENDA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Información de la tienda"
            android:textColor="#172B5B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- NOMBRE DE TIENDA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_usuario"
                android:tint="#A5AAB1"
                android:contentDescription="Nombre de la tienda" />

            <EditText
                android:id="@+id/etNombreTienda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Nombre de la tienda"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DESCRIPCIÓN -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:gravity="top|center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="18dp"
                android:src="@drawable/ic_documento"
                android:tint="#A5AAB1"
                android:contentDescription="Descripción" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:paddingTop="18dp"
                android:hint="Descripción de la tienda"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DIRECCIÓN -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_documento"
                android:tint="#A5AAB1"
                android:contentDescription="Dirección" />

            <EditText
                android:id="@+id/etDireccion"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Dirección (opcional)"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- SITIO WEB Y REDES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_correo"
                android:tint="#A5AAB1"
                android:contentDescription="Sitio web o redes" />

            <EditText
                android:id="@+id/etSitioWeb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Sitio web o redes sociales (opcional)"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#858585"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- BOTÓN REGISTRAR -->

        <Button
            android:id="@+id/btnGuardarTienda"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#0A54D5"
            android:text="REGISTRAR VENDEDOR Y TIENDA"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- BOTÓN CANCELAR -->

        <Button
            android:id="@+id/btnCancelarTienda"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E9EDF5"
            android:text="CANCELAR"
            android:textColor="#172B5B"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>