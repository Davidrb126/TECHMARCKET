<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnVolverMiTienda"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Volver"
                android:clickable="true"
                android:focusable="true"
                android:scaleType="centerInside"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi tienda"
                    android:textColor="#172033"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMACIÓN DEL NEGOCIO"
                    android:textColor="#788397"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"/>

            </LinearLayout>

        </LinearLayout>

        <!-- TÍTULO Y DESCRIPCIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información de tu negocio"
            android:textColor="#172033"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Administra la información que identifica tu tienda en TechMarket."
            android:textColor="#788397"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="18dp"/>

        <!-- TARJETA DEL LOGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/imgLogoMiTienda"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:contentDescription="Logo de la tienda"
                android:background="#EEF1F6"
                android:padding="8dp"/>

            <Button
                android:id="@+id/btnCambiarLogoTienda"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="Cambiar logo"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#0A54D5"
                android:textColor="#FFFFFF"
                android:minWidth="145dp"/>

        </LinearLayout>

        <!-- FORMULARIO DE INFORMACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="1dp">

            <!-- NOMBRE DE LA TIENDA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de la tienda *"
                android:textColor="#172033"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNombreTienda"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_campo_perfil"
                android:hint="Nombre de tu negocio"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#172033"
                android:textColorHint="#9299A5"
                android:textSize="16sp"
                android:singleLine="true"/>

            <!-- DESCRIPCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción *"
                android:textColor="#172033"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDescripcionTienda"
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:background="@drawable/bg_campo_perfil"
                android:gravity="top|start"
                android:hint="Describe los productos y servicios de tu tienda"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="#172033"
                android:textColorHint="#9299A5"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp"/>

            <!-- DIRECCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dirección"
                android:textColor="#172033"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDireccionTienda"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_campo_perfil"
                android:hint="Dirección de tu negocio"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#172033"
                android:textColorHint="#9299A5"
                android:textSize="16sp"
                android:singleLine="true"/>

            <!-- SITIO WEB O REDES SOCIALES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sitio web o redes sociales"
                android:textColor="#172033"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etSitioWebTienda"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_campo_perfil"
                android:hint="https:// o usuario de redes sociales"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#172033"
                android:textColorHint="#9299A5"
                android:textSize="16sp"
                android:singleLine="true"/>

        </LinearLayout>

        <!-- BOTÓN GUARDAR -->
        <Button
            android:id="@+id/btnGuardarTienda"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#0A54D5"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>
